<?xml version="1.0"?>
<robot name="cube">
  <material name="Red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>

  <link name="cube_link">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="Red"/>
    </visual>
    
    <collision>
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0000225" ixy="0" ixz="0" 
               iyy="0.0000225" iyz="0" 
               izz="0.0000225"/>
      <origin xyz="0 0 0"/>
    </inertial>
  </link>

  <gazebo reference="cube_link">
    <material>Gazebo/Red</material>
    <mu1>200</mu1>
    <mu2>100</mu2>
    <kp>30000.0</kp>
    <kd>15.0</kd>
    <minDepth>0.0001</minDepth>
    <maxVel>0.01</maxVel>
  </gazebo>
</robot>