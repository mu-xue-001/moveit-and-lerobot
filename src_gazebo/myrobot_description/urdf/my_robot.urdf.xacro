<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find myrobot_description)/urdf/common_properties.xacro" />
<xacro:include filename="$(find myrobot_description)/urdf/arm.xacro" />
<xacro:include filename="$(find myrobot_description)/urdf/gripper.xacro" />
<xacro:include filename="$(find myrobot_description)/urdf/gazebo.xacro" />
<xacro:include filename="$(find myrobot_description)/urdf/camera.xacro" />

    <link name="world"/>
 
    <joint name="fixed" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
    </joint>

    <joint name="gripper_base_joint" type="fixed">
        <parent link="tool_link" />
        <child link="gripper_base_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

     <joint name="camera_joint" type="fixed">
        <parent link="hand_link" />
        <child link="camera_link" />
        <origin xyz="0.0 0.075 0.0" rpy="${-pi/2} ${-pi/2} 0.0" />
    </joint>

</robot>